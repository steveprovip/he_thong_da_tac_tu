:root{color-scheme:dark;--bg:#080e13;--panel:#0e171e;--line:#25343d;--text:#e0eeec;--muted:#91a5ae;--mint:#5ae5be;--amber:#f5bc77;--red:#ff8797;--mono:Consolas,'Cascadia Code',monospace;font-family:'Segoe UI',sans-serif;font-size:14px}*{box-sizing:border-box}body{margin:0;background:radial-gradient(ellipse at 18% 12%,#14273066,transparent 45%),var(--bg);color:var(--text)}header{height:88px;border-bottom:1px solid var(--line);padding:0 4vw;display:flex;align-items:center;justify-content:space-between}.wordmark{font-size:23px;letter-spacing:2px;font-weight:800;color:var(--text);text-decoration:none}.wordmark span{color:var(--mint)}.wordmark small{display:block;font:9px var(--mono);letter-spacing:3px;color:var(--muted);margin-top:5px}.connection{display:flex;align-items:center;gap:12px;font:10px var(--mono);letter-spacing:1px}.connection i{width:6px;height:6px;background:var(--amber);border-radius:50%}.connection i.online{background:var(--mint);box-shadow:0 0 10px #5ae5be77}#clock{padding-left:20px;color:var(--muted)}main{max-width:1680px;margin:auto;padding:38px 4vw 0}.intro{display:flex;justify-content:space-between;align-items:center;margin-bottom:26px}.eyebrow{font:10px var(--mono);letter-spacing:2px;color:var(--mint)}h1{font-weight:500;letter-spacing:-1.8px;font-size:42px;margin:8px 0}.accent{color:var(--mint)}.mode{text-align:right;font:12px var(--mono);color:var(--mint);letter-spacing:1px}.mode small{display:block;color:var(--muted);font-size:10px;margin-top:9px}.status{display:flex;gap:20px;align-items:center;padding:13px 0;border-block:1px solid var(--line);font:10px var(--mono);flex-wrap:wrap}.label{color:var(--muted);letter-spacing:1px}.status strong{font-weight:400;color:var(--amber);flex:1}.tag{border:1px solid #354a4b;color:#a1bcb7;padding:4px 7px;font-size:9px}.metrics{display:grid;grid-template-columns:1.2fr 1.2fr 1fr 1fr;padding:27px 0 32px}.metrics article{padding:0 24px;border-right:1px solid var(--line)}.metrics article:first-child{padding-left:0}.metrics article:last-child{border:0}.metrics p{font:10px var(--mono);color:var(--muted);letter-spacing:1px}.metrics p small{font-size:9px;margin-left:8px;color:var(--mint)}.metrics h2{font:32px var(--mono);margin:14px 0 9px;letter-spacing:-1.5px}.metrics span{font-size:10px;color:var(--muted)}.metrics b{font-weight:400;color:var(--text)}.positive{color:var(--mint)}.negative{color:var(--red)}.workbench{display:grid;grid-template-columns:1.15fr 1fr;gap:18px}.panel{border:1px solid var(--line);background:linear-gradient(140deg,#12222b66,#0e171e99);min-width:0}.panel-title{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:18px 22px;border-bottom:1px solid var(--line)}h3{margin:0;font:10px var(--mono);font-weight:400;letter-spacing:1.2px}.panel-title>span{font:8px var(--mono);color:var(--muted);letter-spacing:.8px}.organism{grid-row:span 2;overflow:hidden}#octopus{display:block;width:100%;max-height:350px}.orbit{stroke:#263d44;fill:none;stroke-dasharray:2 8}.inner{stroke-dasharray:1 5}.head path:first-child{fill:#102c2c;stroke:var(--mint);stroke-width:1.2}.head .eyes{fill:none;stroke:var(--mint);stroke-width:3}.head circle{fill:var(--mint)}.core-label{fill:#709791;font:8px var(--mono);letter-spacing:2px}.arm path{fill:none;stroke:#36535b;stroke-width:2;transition:stroke .2s}.arm circle{fill:#0d1a21;stroke:#547078;stroke-width:1}.arm text{fill:#b7ccce;font:11px var(--mono);letter-spacing:1px}.arm.approve path,.arm.approve circle{stroke:var(--mint)}.arm.reject path,.arm.reject circle{stroke:var(--red)}.consensus{display:flex;align-items:center;justify-content:space-between;padding:0 25px}.consensus p{font:9px var(--mono);letter-spacing:1.5px;color:var(--muted)}.consensus strong{font:56px var(--mono);font-weight:400;letter-spacing:-3px}.consensus strong span{font-size:26px;color:var(--mint)}.gate-note{font:10px/2 var(--mono);color:var(--muted)}.track{height:4px;background:#25373b;margin:15px 25px;position:relative}.track>div{height:4px;background:var(--mint);width:0;transition:width .2s}.threshold{position:absolute;left:76.8%;top:-4px;height:12px;width:1px;background:var(--amber)}.footnote{font-size:10px;line-height:1.7;color:var(--muted);margin:18px 25px 22px;max-width:470px}.agent{display:grid;grid-template-columns:28px 1fr 60px 65px;align-items:center;gap:10px;padding:12px 20px;border-bottom:1px solid #20303977}.agent:last-child{border:0}.agent .index{font:9px var(--mono);color:#5f828b}.agent strong{font:11px var(--mono);letter-spacing:1px}.agent small{display:block;color:var(--muted);font-size:9px;margin-top:3px}.agent .stance{font:9px var(--mono);text-align:center;border:1px solid var(--line);padding:4px}.agent .confidence{font:13px var(--mono);text-align:right}.equity-panel{padding-bottom:13px}#equity-chart{width:calc(100% - 44px);height:100px;margin:15px 22px 5px;border-bottom:1px solid var(--line)}#equity-line{fill:none;stroke:var(--mint);stroke-width:2;vector-effect:non-scaling-stroke}.chart-bottom{display:flex;justify-content:space-between;gap:20px;font:8px var(--mono);color:var(--muted);padding:0 22px}.market-panel{margin-top:18px}.table-scroll{overflow-x:auto}table{width:100%;border-collapse:collapse;text-align:left;font:11px var(--mono);white-space:nowrap}th{font-size:9px;font-weight:400;color:var(--muted);padding:15px 22px}td{padding:14px 22px;border-top:1px solid #25343d88}td:last-child{font-size:9px;color:var(--amber)}.bottom-grid{display:grid;grid-template-columns:1fr 1fr;gap:18px;margin-top:18px}.positions{padding:20px 22px;color:var(--muted);font:11px/2 var(--mono)}.position{border-bottom:1px solid var(--line);padding:8px 0}#events{list-style:none;margin:0;padding:10px 22px;max-height:195px;overflow:auto}#events li{font:10px/1.7 var(--mono);padding:7px 0;border-bottom:1px solid #25343d88;overflow-wrap:anywhere}#events time{color:var(--muted);margin-right:12px}footer{display:flex;justify-content:space-between;gap:20px;padding:26px 0;color:var(--muted);font:9px/1.8 var(--mono)}@media(min-width:1450px){#octopus{max-height:385px}.agent{padding-block:14px}}@media(max-width:900px){main{padding-top:25px}.workbench{grid-template-columns:1fr}.organism{grid-row:auto}.metrics{grid-template-columns:1fr 1fr;gap:25px}.metrics article:nth-child(3){padding-left:0}.metrics article:nth-child(2){border:0}.bottom-grid{grid-template-columns:1fr}h1{font-size:34px}.chart-bottom{font-size:7px}}@media(max-width:550px){header{height:76px}.connection{font-size:8px}.connection #clock{display:none}.wordmark{font-size:19px}.intro{display:block}.mode{text-align:left;margin-top:18px}.metrics h2{font-size:24px}.metrics article{padding-right:10px;padding-left:15px}.status{gap:12px}.panel-title{padding:16px}.panel-title>span{font-size:7px}footer{display:block}.agent{padding-inline:15px}.consensus strong{font-size:46px}td,th{padding:13px 16px}}@media(prefers-reduced-motion:reduce){*{transition:none!important}}
