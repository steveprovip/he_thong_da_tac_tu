+@dataclass(frozen=True)
+class CarrySnapshot:
+    symbol: str
+    spot_bid: float
+    spot_ask: float
+    perp_bid: float
+    perp_ask: float
+    rate: float
+    interval_hours: int
+    next_funding: float
+    oi_usdt: float
