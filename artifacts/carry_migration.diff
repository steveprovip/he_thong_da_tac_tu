+@dataclass(frozen=True)
+class SpotPerpCarryPlan:
+    symbol: str
+    apr: float
+    horizon_days: float
+    gross_bps: float
+    cost_bps: float
+    net_bps: float
+    basis_fraction: float
+    projected_rate: float
