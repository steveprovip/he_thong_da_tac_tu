+            trades = await self.my_trades(symbol, response['orderId'])
+            if sum((dec(t['qty']) for t in trades), dec(0)) != dec(response['executedQty']):
+                raise RuntimeError('Spot trade history incomplete')
+            return dict(response, fills=trades)
+        return response
