+def authorize(authority, pair):
+    policy = ConsensusEngine(trend_floor=.768)
+    decision = policy.evaluate([Vote(a, 'SELL', 1, 'verified fixture') for a in policy.weights])
+    return authority.issue_pair(pair, decision)
